library(shiny)
library(ggplot2)
library(readr)
library(dplyr)

#load + light clean 
fl <- read_csv("Florida_COVID19_10302020_ByCounty_CSV_Partial.csv",
               show_col_types = FALSE) |>
  filter(COUNTYNAME != "A State") |>
  transmute(
    county = COUNTYNAME,
    NewPercPos, NewTested, NewPos,
    T_positive, T_negative, Deaths,
    MedianAge, EverMon, MonNow
  ) |>
  na.omit()

# variable choices for dropdowns
metric_choices <- c(
  "New percent positive" = "NewPercPos",
  "New tested"           = "NewTested",
  "New positives"        = "NewPos",
  "Total positives"      = "T_positive",
  "Total negatives"      = "T_negative",
  "Deaths"               = "Deaths",
  "Median age"           = "MedianAge",
  "Ever monitored"       = "EverMon",
  "Monitored now"        = "MonNow"
)

ui <- fluidPage(
  titlePanel("Florida COVID-19 by County — Explorer"),
  sidebarLayout(
    sidebarPanel(
      # overview controls
      selectInput("metric", "Metric:", choices = metric_choices, selected = "NewPercPos"),
      sliderInput("topN", "Show top N counties:", min = 5, max = 25, value = 10, step = 1),
      checkboxInput("logy", "Log scale (bar & dist)", FALSE),
      tags$hr(),
      # compare tab controls
      selectInput("xvar", "X-axis:", choices = metric_choices, selected = "T_positive"),
      selectInput("yvar", "Y-axis:", choices = metric_choices, selected = "T_negative"),
      checkboxInput("logx_sc", "Log X (scatter)", FALSE),
      checkboxInput("logy_sc", "Log Y (scatter)", FALSE)
    ),
    mainPanel(
      tabsetPanel(
        tabPanel("Overview (Top Counties)",
                 plotOutput("barTop", height = "360px")
        ),
        tabPanel("Distribution",
                 plotOutput("distPlot", height = "360px")
        ),
        tabPanel("Compare (Scatter)",
                 plotOutput("scatter", height = "420px")
        ),
        tabPanel("Table",
                 tableOutput("tbl"))
      )
    )
  )
)

server <- function(input, output){
  
  # helper
  pretty_lab <- reactive({
    names(metric_choices)[metric_choices == input$metric]
  })
  
  # Top N bar chart
  output$barTop <- renderPlot({
    df <- fl |>
      arrange(desc(.data[[input$metric]])) |>
      slice_head(n = input$topN) |>
      mutate(county = reorder(county, .data[[input$metric]]))
    
    p <- ggplot(df, aes_string(x = "county", y = input$metric)) +
      geom_col(fill = "#2c7fb8") +
      coord_flip() +
      labs(title = paste0("Top ", input$topN, " counties by ", pretty_lab()),
           x = NULL, y = pretty_lab()) +
      theme_minimal(base_size = 13)
    if (input$logy) p <- p + scale_y_log10()
    p
  })
  
  # Distribution plot
  output$distPlot <- renderPlot({
    p <- ggplot(fl, aes_string(x = input$metric)) +
      geom_histogram(bins = 30, alpha = 0.7) +
      geom_density(linewidth = 1) +
      labs(title = paste0("Distribution of ", pretty_lab()),
           x = pretty_lab(), y = "Count") +
      theme_minimal(base_size = 13)
    if (input$logy) p <- p + scale_y_log10()
    p
  })
  
  # Scatter compare
  output$scatter <- renderPlot({
    p <- ggplot(fl, aes_string(x = input$xvar, y = input$yvar, size = "NewTested", color = "MedianAge")) +
      geom_point(alpha = 0.8) +
      scale_size_continuous(range = c(2,10)) +
      labs(title = "Compare two metrics by county",
           x = names(metric_choices)[metric_choices == input$xvar],
           y = names(metric_choices)[metric_choices == input$yvar],
           size = "New tested",
           color = "Median age") +
      theme_minimal(base_size = 13)
    if (input$logx_sc) p <- p + scale_x_log10()
    if (input$logy_sc) p <- p + scale_y_log10()
    p
  })
  
  # Simple preview table (first 12 rows)
  output$tbl <- renderTable({
    head(fl, 12)
  })
}

shinyApp(ui = ui, server = server)
